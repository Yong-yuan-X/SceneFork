# Browser-safe configuration. Never put API keys in VITE_* variables.
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_VIDEO_POLL_MS=4000
VITE_USE_LOCAL_MOCK=false

# Server configuration. Mock is the safe default and never calls paid APIs.
SCENEFORK_PROVIDER_MODE=mock
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173

# Leave empty until you intentionally enable real provider mode.
DASHSCOPE_API_KEY=
# Optional model-specific keys take precedence over the legacy shared key above.
QWEN_API_KEY=
WAN_API_KEY=
# Optional per-model modes. When omitted, SCENEFORK_PROVIDER_MODE is used.
# QWEN_PROVIDER_MODE=mock
# WAN_PROVIDER_MODE=mock
QWEN_MODEL=qwen3.7-flash
WAN_MODEL=wan2.6-t2v
# The endpoints and API key must belong to the same Alibaba Cloud region/workspace.
# QWEN_BASE_URL ends with /compatible-mode/v1; WAN_BASE_URL ends with /api/v1.
QWEN_BASE_URL=
WAN_BASE_URL=
DATABASE_URL=./data/scenefork.db
MEDIA_DIR=./media
WAN_VIDEO_SIZE=1920*1080
WAN_VIDEO_DURATION=5
WAN_PROVIDER_POLL_MS=15000
PROVIDER_REQUEST_TIMEOUT_MS=120000
QWEN_REQUEST_TIMEOUT_MS=120000
QWEN_MAX_RETRIES=2
FFMPEG_PATH=ffmpeg
FFMPEG_TIMEOUT_MS=15000
