QWEN_MODEL=qwen3.8-flash
WAN_MODEL=wan2.6-t2v
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
WAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DATABASE_URL=./data/scenefork.db
MEDIA_DIR=./media
WAN_VIDEO_SIZE=1280*720
WAN_VIDEO_DURATION=5
WAN_PROVIDER_POLL_MS=15000
